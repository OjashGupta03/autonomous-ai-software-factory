# Copy to .env and fill in real values. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security ---------------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://factory:factory@localhost:5432/factory

# --- Redis --------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --- CORS (frontend origins, comma-separated) ---------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model providers -----------------------------------------------------
# Leave a provider's key unset and its tier's MODEL_PROVIDER_* as "stub"
# to dry-run the orchestrator with zero API cost - see docs/08-model-routing.md.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Tier -> model name / provider. Change these to swap models without a
# code change - see docs/08-model-routing.md.
MODEL_CHEAP=gpt-4o-mini
MODEL_PROVIDER_CHEAP=openai
MODEL_CODING=claude-sonnet-5
MODEL_PROVIDER_CODING=anthropic
MODEL_REASONING=claude-opus-4-8
MODEL_PROVIDER_REASONING=anthropic
MODEL_FALLBACK=gpt-4o-mini
MODEL_PROVIDER_FALLBACK=openai

# --- Context budgets (tokens) - see docs/06-context-engineering.md -------
CONTEXT_BUDGET_PLANNER_TOKENS=8000
CONTEXT_BUDGET_CODING_TOKENS=4000
CONTEXT_BUDGET_REVIEW_TOKENS=3000
CONTEXT_BUDGET_DEBUG_TOKENS=5000
CONTEXT_BUDGET_TEST_TOKENS=3000
CONTEXT_BUDGET_DOCS_TOKENS=3000

# --- Orchestration / failure recovery ------------------------------------
MAX_TASK_RETRIES=3
RETRY_BACKOFF_BASE_SECONDS=2.0
RETRY_BACKOFF_MAX_SECONDS=60.0
MAX_PARALLEL_TASKS=4
TASK_BATCH_AWAIT_TIMEOUT_SECONDS=900
AGENT_TOOL_LOOP_MAX_ITERATIONS=8

# --- Cost controls ---------------------------------------------------------
DEFAULT_PROJECT_TOKEN_BUDGET=500000
HIGH_COST_ESCALATION_USD=1.00

# --- Sandbox execution - see docs/11-code-execution-sandbox.md -----------
SANDBOX_ENABLED=true
SANDBOX_IMAGE=daedalus-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true
WORKSPACE_ROOT=/tmp/daedalus-workspaces
